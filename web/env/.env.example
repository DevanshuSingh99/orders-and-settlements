# =============================================================================
# Orders & Settlements - frontend environment configuration.
#
# The frontend is deployed separately (Cloudflare Pages) from the backend,
# so it keeps its own env/ folder rather than sharing the root one. Values
# here are read by next.config.ts at BUILD time and baked into the static
# output - see docs/implementation-plan.md section 4.
#
# Copy this file to `.env` (local dev), `.env.dev`, or `.env.prod`. NEVER
# commit `.env`, `.env.dev`, or `.env.prod` - only this `.env.example`.
# =============================================================================

# Base URL of the API gateway. No trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
