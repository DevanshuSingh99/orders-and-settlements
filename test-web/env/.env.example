# =============================================================================
# Orders & Settlements - test dashboard environment configuration.
#
# Built and deployed separately (Cloudflare Pages) from the backend.
# Values are read by next.config.ts at BUILD time and baked into the static
# output.
#
# Copy this file to `.env` (local dev), `.env.dev`, or `.env.prod`. NEVER
# commit `.env`, `.env.dev`, or `.env.prod` - only this `.env.example`.
# =============================================================================

# Base URL of the test-runner service. No trailing slash.
NEXT_PUBLIC_TEST_API_BASE_URL=http://localhost:4004
