# =============================================================================
# Orders & Settlements - shared backend environment configuration.
#
# This ONE file is read by the gateway and all three backend services
# (auth-service, orders-service, payments-service). It is loaded by Docker
# Compose via `env_file`, and by each service's own `src/config/env.ts`
# when run outside Docker. See docs/implementation-plan.md section 4.
#
# Copy this file to `.env` (local dev), `.env.dev`, or `.env.prod` and fill
# in real values. NEVER commit `.env`, `.env.dev`, or `.env.prod` - only
# this `.env.example` file (with placeholder values) is committed.
# =============================================================================

# Which file variant to load: dev | prod. Leave unset locally to use `.env`.
APP_ENV=dev
NODE_ENV=development
LOG_LEVEL=info

# --- Postgres --------------------------------------------------------------
# One Postgres instance, one schema per service (auth, orders, payments).
# All services connect with the same URL and set `search_path` to their own
# schema on connect.
POSTGRES_USER=oas_app
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=oas
DATABASE_URL=postgres://oas_app:change-this-postgres-password@postgres:5432/oas

# --- Redis -------------------------------------------------------------
# Used for refresh-token/session storage and rate limiting.
REDIS_URL=redis://redis:6379

# --- Auth / JWT --------------------------------------------------------
# HS256 shared secret used to sign and verify access tokens. The gateway and
# every service verify tokens locally with this same secret - generate a
# long random value for real environments, e.g. `openssl rand -hex 32`.
JWT_SECRET=dev-only-change-me-32-bytes-minimum-please
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# --- CORS ----------------------------------------------------------------
# Comma-separated list of allowed browser origins (the deployed frontend).
# Include test-web origin (default :3001) so the browser test dashboard can call the runner.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4004

# --- Service ports (used both for binding and for the gateway's proxy) ---
GATEWAY_PORT=4000
AUTH_PORT=4001
ORDERS_PORT=4002
PAYMENTS_PORT=4003
TEST_RUNNER_PORT=4004

# --- Internal service URLs (how the gateway reaches each service) --------
AUTH_SERVICE_URL=http://auth-service:4001
ORDERS_SERVICE_URL=http://orders-service:4002
PAYMENTS_SERVICE_URL=http://payments-service:4003

# --- Rate limiting (gateway) ---------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Test runner (browser test UI + server-side load) ---------------------
# Disabled unless TEST_RUNNER_ENABLED=true. Uses a separate JWT secret so
# runner tokens can never be used as normal user access tokens.
TEST_RUNNER_ENABLED=true
TEST_RUNNER_USER=testrunner
TEST_RUNNER_PASSWORD=change-me-test-runner
TEST_RUNNER_JWT_SECRET=dev-only-runner-secret-32-bytes-min
TEST_RUNNER_JWT_TTL=2h
# Gateway URL as reached FROM the test-runner container / process.
# Local (outside Compose): http://localhost:4000
PUBLIC_API_BASE_URL=http://gateway:4000
